# ── Bridge access (who may call this MCP server) ─────────────────────────────
MCP_TOKEN=long_random_secret                   # the one bearer every client presents (full access)
# MCP_ACCESS_TOKEN=...                         # pre-2.3 name of the same thing; still accepted
# MCP_READ_TOKEN=another_secret                # optional second token that can only read
# MCP_READ_TOKEN_SCOPE=admin                   # (pre-2.3) promote MCP_READ_TOKEN to full access
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# ── GoHighLevel credentials — pick ONE mode ──────────────────────────────────
# Mode 1: one agency-level Private Integration covers every sub-account.
#   NOTE: needs the `oauth.write` scope, which GoHighLevel does not offer on Private
#   Integrations as of 2026-09 (only Marketplace OAuth apps get it) — use Mode 2 unless that changes.
#   The agency PIT needs the `oauth.write` scope (plus the sub-account scopes you use);
#   the server mints a per-sub-account token via POST /oauth/locationToken and caches it.
GHL_AGENCY_KEY=pit-agency-level-private-integration
GHL_COMPANY_ID=your_agency_company_id
GHL_DEFAULT_LOCATION_ID=sub_account_used_when_no_locationId_is_passed
# GHL_LOCATION_IDS=locA,locB                   # optional: restrict to these sub-accounts
# GHL_LOCATION_NAMES=locA=TruTerra,locB=DC RE  # optional: friendlier names

# Mode 2 (recommended): one sub-account PIT per location, no agency key.
#   One env var per sub-account — add or rotate one without touching the others:
# GHL_KEY_locA=pit-...
# GHL_KEY_locB=pit-...
#   (also accepted: GHL_LOCATION_KEYS=locA=pit-...,locB=pit-...  and the Mode 3 pair below,
#    which counts as one key — so a legacy deployment becomes multi-location by adding GHL_KEY_<other>)
# GHL_DEFAULT_LOCATION_ID=locA

# Mode 3 (legacy): exactly one sub-account.
# GHL_API_KEY=pit-sub-account-private-integration
# GHL_LOCATION_ID=your_location_id

GHL_BASE_URL=https://services.leadconnectorhq.com

# Server Configuration
MCP_SERVER_PORT=8000
NODE_ENV=development
